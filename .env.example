# ========================================
# PEDIDOS360 - Environment Variables
# ========================================
# Este archivo documenta todas las variables de entorno requeridas.
# Copiar a .env y ajustar valores para tu entorno.
# NUNCA commitear el archivo .env con credenciales reales.

# ========================================
# RABBITMQ CONFIGURATION
# ========================================
# Configuración de conexión a RabbitMQ para mensajería asíncrona
# Puerto AMQP: 5672 | Management UI: 15672 | Metrics: 15692

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ========================================
# MYSQL DATABASE CONFIGURATION
# ========================================
# Configuración de base de datos MySQL para persistencia
# Puerto: 3306

# Credenciales de root (solo para desarrollo local)
MYSQL_ROOT_PASSWORD=rootpass

# Base de datos de la aplicación
MYSQL_DATABASE=pedidos360

# Usuario de aplicación (preferido sobre root)
DB_USERNAME=pedidos360
DB_PASSWORD=devpass

# Host y puerto (para microservicios)
DB_HOST=localhost
DB_PORT=3306

# ========================================
# GRAFANA CONFIGURATION
# ========================================
# Configuración de Grafana para dashboards de monitoreo
# Puerto: 3000

GRAFANA_USER=admin
GRAFANA_PASS=admin

# ========================================
# PROMETHEUS CONFIGURATION
# ========================================
# Configuración de Prometheus para scraping de métricas
# Puerto: 9090

PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# ========================================
# MICROSERVICES CONFIGURATION
# ========================================
# URLs de servicios internos para comunicación entre microservicios

# BFF (Backend for Frontend) - Puerto 8080
BFF_SERVICE_URL=http://localhost:8080

# MS Órdenes - Puerto 8081
ORDENES_SERVICE_URL=http://localhost:8081/api/pedidos

# MS Catálogo - Puerto 8082
CATALOGO_SERVICE_URL=http://localhost:8082/api/catalogo

# MS Mensajería - Puerto 8083
MENSAJERIA_SERVICE_URL=http://localhost:8083/api/mensajeria

# ========================================
# SPRING PROFILES
# ========================================
# Perfil activo de Spring Boot
# Opciones: dev (desarrollo), prod (producción), test (pruebas)

SPRING_PROFILES_ACTIVE=dev

# ========================================
# OAUTH2 / JWT CONFIGURATION
# ========================================
# Configuración de autenticación OAuth2 con Azure AD

# Azure AD Tenant ID
AZURE_TENANT_ID=b6f34517-563c-4ce9-a10b-6f3958083091

# JWT Issuer URI
JWT_ISSUER_URI=https://sts.windows.net/b6f34517-563c-4ce9-a10b-6f3958083091/

# JWT JWK Set URI (para validación de tokens)
JWT_JWK_SET_URI=https://login.microsoftonline.com/b6f34517-563c-4ce9-a10b-6f3958083091/discovery/v2.0/keys

# Application ID (Audience)
JWT_AUDIENCE=api://3bdb2628-3745-4907-9593-53d8c7cb36fb

# ========================================
# CORS CONFIGURATION
# ========================================
# Orígenes permitidos para CORS (separados por coma)

CORS_ALLOWED_ORIGINS=http://localhost:4200,https://54.145.51.231

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Configuración de logs (solo para perfil prod)

# Nivel de log (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Directorio de logs (producción)
LOG_DIR=/var/log/pedidos360

# Rotación de logs
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=1GB

# ========================================
# RABBITMQ ADVANCED SETTINGS
# ========================================
# Configuración avanzada de RabbitMQ

# Retry configuration
RABBITMQ_RETRY_TTL=5000
RABBITMQ_MAX_RETRY_ATTEMPTS=2

# Consumer configuration
RABBITMQ_PREFETCH=1
RABBITMQ_ACKNOWLEDGE_MODE=manual

# ========================================
# DOCKER VOLUMES (Información)
# ========================================
# Los siguientes volúmenes Docker se crean automáticamente:
# - pedidos360_rabbitmq_data: Persistencia de mensajes y configuración RabbitMQ
# - pedidos360_mysql_data: Persistencia de base de datos MySQL
# - pedidos360_prometheus_data: Persistencia de métricas de Prometheus
# - pedidos360_grafana_data: Persistencia de dashboards y configuración Grafana

# ========================================
# CLOUD DEPLOYMENT (Opcional)
# ========================================
# Variables adicionales para despliegue en cloud (Azure/AWS)

# Azure Configuration (opcional)
# AZURE_MYSQL_HOST=your-mysql-flexible-server.mysql.database.azure.com
# AZURE_MYSQL_SSL_MODE=REQUIRED
# AZURE_SERVICEBUS_CONNECTION_STRING=your-servicebus-connection-string

# AWS Configuration (opcional)
# AWS_RDS_ENDPOINT=your-rds-instance.region.rds.amazonaws.com
# AWS_MQ_BROKER_URL=your-amazonmq-broker-url
# AWS_REGION=us-east-1

# ========================================
# DEVELOPMENT NOTES
# ========================================
# 1. Para desarrollo local, los valores por defecto son suficientes
# 2. Para producción, cambiar TODAS las contraseñas y credenciales
# 3. Asegurar que .env esté en .gitignore
# 4. Usar variables de entorno del sistema en producción (no archivos .env)
# 5. Verificar conectividad de red entre contenedores Docker
